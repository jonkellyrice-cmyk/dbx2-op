{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Character creation data (DBX2-op extension)",
 "description": "Races, heights and body types: facts about the character the player creates, used as context (spec §11), never as equipped options. A DBX2-op addition to the v3.1 bundle, reusing its Evidence and KnownNumber types.",
 "type": "object",
 "additionalProperties": false,
 "required": ["version", "races", "heights", "body_types"],
 "$defs": {
  "Trait": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "kind", "text", "property", "operation", "magnitude", "condition", "evidence"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"enum": ["bonus", "penalty", "neutral"], "description": "neutral: a ranking that is neither a clear strength nor a weakness (for example, middle-of-the-pack health)"},
    "text": {"type": "string", "minLength": 1, "description": "The trait as the source words it"},
    "property": {"type": "string", "minLength": 1, "description": "What it changes: max_health, movement_speed, stamina_recovery..."},
    "operation": {"enum": ["multiply", "add", "chance", "qualitative"], "description": "qualitative: the source states a direction (high/low) but no number"},
    "magnitude": {"$ref": "vocabulary.schema.json#/$defs/KnownNumber"},
    "condition": {"type": ["string", "null"]},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"}
   }
  },
  "Race": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "archetypes", "name", "summary", "traits", "spec_ref", "evidence", "moveset"],
   "properties": {
    "id": {"type": "string", "pattern": "^race\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "archetypes": {"type": "array", "minItems": 1, "items": {"enum": ["male_saiyan", "female_saiyan", "male_earthling", "female_earthling", "male_majin", "female_majin", "namekian", "frieza_race"]}},
    "name": {"type": "string"},
    "summary": {"type": "string"},
    "traits": {"type": "array", "items": {"$ref": "#/$defs/Trait"}},
    "spec_ref": {"$ref": "vocabulary.schema.json#/$defs/SpecRef"},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"},
    "notes": {"type": ["string", "null"]},
    "moveset": {"$ref": "#/$defs/Moveset", "description": "The race's basic-attack combo strings (each gender has its own record, and its own strings)"}
   }
  },
  "ComboString": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "name", "text", "features", "evidence"],
   "properties": {
    "id": {"type": "string", "pattern": "^(9L|5H|LHH|HLHLH|5L3H|grab|light_break|heavy_break|other-[a-z0-9-]+)$"},
    "name": {"type": "string", "minLength": 1},
    "text": {"type": ["string", "null"], "description": "The string as the source describes it; null when no source describes it yet"},
    "features": {"type": "array", "uniqueItems": true, "items": {"enum": ["launcher", "juggle", "long_knockback", "hard_knockdown", "stun", "teleport", "chase", "extended_reach", "step_cancel", "guard_cancel", "branch"]},
     "description": "What the source says the string does: launcher (sends the opponent flying), juggle (puts them in a juggle state), long_knockback, hard_knockdown, stun, teleport (the user teleports mid-string), chase (the user chases a flying opponent), extended_reach (stretching limbs), step_cancel and guard_cancel (can be cancelled that way), branch (another input switches to a different ending). Empty when the string is undescribed."},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"}
   }
  },
  "Moveset": {
   "type": "object", "additionalProperties": false,
   "required": ["based_on", "strings", "traits", "evidence", "notes"],
   "properties": {
    "based_on": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["character", "note"], "properties": {"character": {"type": "string"}, "note": {"type": "string"}}}, "description": "Roster characters the source says these animations come from; a lead for research, not a copy of their strings"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/ComboString"}},
    "traits": {"type": "array", "items": {"$ref": "#/$defs/Trait"}},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"},
    "notes": {"type": ["string", "null"]}
   }
  },
  "Height": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "step", "label", "health_multiplier", "speed_multiplier", "evidence"],
   "properties": {
    "id": {"type": "string", "pattern": "^height\\.[1-4]$"},
    "step": {"type": "integer", "minimum": 1, "maximum": 4},
    "label": {"type": "string"},
    "health_multiplier": {"$ref": "vocabulary.schema.json#/$defs/KnownNumber"},
    "speed_multiplier": {"$ref": "vocabulary.schema.json#/$defs/KnownNumber"},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"},
    "notes": {"type": ["string", "null"]}
   }
  },
  "BodyType": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "name", "strike_and_basic_damage_bonus", "ki_super_damage_bonus", "evidence"],
   "properties": {
    "id": {"type": "string", "pattern": "^body\\.(thin|average|thick)$"},
    "name": {"type": "string"},
    "strike_and_basic_damage_bonus": {"$ref": "vocabulary.schema.json#/$defs/KnownNumber"},
    "ki_super_damage_bonus": {"$ref": "vocabulary.schema.json#/$defs/KnownNumber"},
    "evidence": {"$ref": "vocabulary.schema.json#/$defs/Evidence"},
    "notes": {"type": ["string", "null"]}
   }
  }
 },
 "properties": {
  "version": {"type": "string"},
  "races": {"type": "array", "items": {"$ref": "#/$defs/Race"}},
  "heights": {"type": "array", "items": {"$ref": "#/$defs/Height"}, "minItems": 4, "maxItems": 4},
  "body_types": {"type": "array", "items": {"$ref": "#/$defs/BodyType"}, "minItems": 3, "maxItems": 3}
 }
}
