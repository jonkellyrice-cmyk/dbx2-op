{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommunityFinding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "vocabulary.schema.json#/$defs/EntityId"
      },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "properties": {
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "patch"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ref",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "agreement": {
      "type": "string",
      "enum": [
        "single",
        "several",
        "broad"
      ]
    },
    "tested_by_us": {
      "type": "boolean"
    },
    "optimizer_says": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "confirmed",
        "rejected",
        "outdated"
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_case": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^A-[0-9]{3,}$"
    },
    "spec_ref": {
      "$ref": "vocabulary.schema.json#/$defs/SpecRef"
    },
    "version": {
      "$ref": "vocabulary.schema.json#/$defs/ContentVersion"
    },
    "evidence": {
      "$ref": "vocabulary.schema.json#/$defs/Evidence"
    }
  },
  "required": [
    "id",
    "claim",
    "options",
    "context",
    "sources",
    "agreement",
    "tested_by_us",
    "optimizer_says",
    "status",
    "resolution",
    "acceptance_case",
    "spec_ref",
    "version",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "rejected",
              "outdated"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
