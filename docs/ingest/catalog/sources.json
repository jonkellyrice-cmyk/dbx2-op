  {"key": "OWNER-OBSERVATION", "title": "The owner's own in-game observation", "url": null, "revision": null, "checked": "2026-11-26", "kind": "player", "note": "100 Ki is one Ki bar, and 100 stamina is one stamina bar. Also the owner's in-game screenshots of 2026-11-26: level, attribute points, equipped loadout, and the owned skills, Super Souls and QQ Bangs recorded in owned.json."},
  {"key": "OWNER-QQ-TARGET", "title": "The owner's target QQ Bang for a Ki-blast build", "url": null, "revision": null, "checked": "2026-11-26", "kind": "player", "note": "Health, Ki, Stamina, Basic Attacks and Ki Blast Supers +5, Strike Supers -5; each attribute runs from -5 to +5. Its author marks it as a target, not a verified roll."},
  {"key": "COMMUNITY-QQ-ARROWS", "title": "Community estimates of what each QQ Bang arrow is worth (Reddit and Steam Community, gathered in the owner's research chat)", "url": null, "revision": null, "checked": "2026-11-26", "kind": "community", "note": "Per arrow: Health +300 HP; Max Ki +0.4 Ki bars; Max Stamina +0.4 stamina bars; Basic Attacks, Strike Supers and Ki Blast Supers about +1% damage, which the wiki's Attributes page (R3) corrects to 6.66% for +5 with no attribute points. Approximate, from community testing, not checked against the latest patch; see community-findings.yaml C-001 and C-002."},
